{
  "tcp_server": {
    "port": 5555,
    "bind_address": "0.0.0.0"
  },
  "i2c": {
    "device": "/dev/i2c-1",
    "imu_enabled": true,
    "simulation_mode": true
  },
  "logging": {
    "level": "info",
    "console": true,
    "file": true,
    "file_path": "/var/log/robo_chassis/robot.log",
    "max_size_mb": 10,
    "max_files": 5,
    "memory_cache_clear_threshold": 0.85,
    "memory_critical_threshold": 0.95
  },
  "telemetry": {
    "update_interval_ms": 20,
    "connection_timeout_attempts": 10
  },
  "watchdog": {
    "enabled": false,
    "timeout_sec": 30
  }
}
